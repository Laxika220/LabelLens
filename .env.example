# Vision service (Python). Required for the main, cross-checked reading.
VISION_SERVICE_URL=http://127.0.0.1:8001
VISION_SERVICE_TOKEN=change-me-to-a-long-random-string

# Optional: Claude vision. Used by the vision service as an independent
# check, and by the web app as a fallback reader.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: raises the PubMed rate limit.
NCBI_API_KEY=
